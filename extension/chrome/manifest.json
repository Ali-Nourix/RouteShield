{
  "manifest_version": 3,
  "name": "RouteShield",
  "version": "1.7.1",
  "description": "Send a site — and the domains it loads from — through a different RouteShield profile, or through no VPN at all.",
  "homepage_url": "https://github.com/Ali-Nourix/RouteShield",
  "icons": {
    "16": "shared/icons/icon-16.png",
    "32": "shared/icons/icon-32.png",
    "48": "shared/icons/icon-48.png",
    "128": "shared/icons/icon-128.png"
  },
  "permissions": [
    "proxy",
    "tabs",
    "storage",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RouteShield",
    "default_popup": "shared/popup.html",
    "default_icon": {
      "16": "shared/icons/icon-16.png",
      "32": "shared/icons/icon-32.png"
    }
  }
}
