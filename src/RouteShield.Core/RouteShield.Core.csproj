<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RouteShield</RootNamespace>
    <AssemblyName>RouteShield.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Symbols live in the assembly, so publishing leaves no loose .pdb in the package. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RouteShield.Core.Tests" />
  </ItemGroup>
</Project>
