<!--
    Modernist design tokens. Everything visual in RouteShield resolves back to this file:
    a paper-white ground, near-black ink, one signal red, and Archivo set very heavy for
    anything structural. Tonal ramps share a lightness scale, so the same step of any role
    carries the same visual weight.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Ground -->
    <Color x:Key="BgColor">#F3F2F2</Color>
    <Color x:Key="SurfaceColor">#EAE9E9</Color>
    <Color x:Key="TextColor">#201E1D</Color>
    <Color x:Key="AccentColor">#EC3013</Color>
    <Color x:Key="Accent2Color">#E15B47</Color>

    <!-- Neutral ramp -->
    <Color x:Key="Neutral100Color">#F8F4F4</Color>
    <Color x:Key="Neutral200Color">#EAE7E7</Color>
    <Color x:Key="Neutral300Color">#D7D3D3</Color>
    <Color x:Key="Neutral400Color">#BAB6B6</Color>
    <Color x:Key="Neutral500Color">#9B9797</Color>
    <Color x:Key="Neutral600Color">#7D7979</Color>
    <Color x:Key="Neutral700Color">#605D5D</Color>
    <Color x:Key="Neutral800Color">#444141</Color>
    <Color x:Key="Neutral900Color">#2D2B2B</Color>

    <!-- Accent ramp -->
    <Color x:Key="Accent100Color">#FFF2EF</Color>
    <Color x:Key="Accent200Color">#FFE0D9</Color>
    <Color x:Key="Accent300Color">#FFC4B8</Color>
    <Color x:Key="Accent400Color">#FF9783</Color>
    <Color x:Key="Accent500Color">#FF563C</Color>
    <Color x:Key="Accent600Color">#DD2B0F</Color>
    <Color x:Key="Accent700Color">#AE1800</Color>
    <Color x:Key="Accent800Color">#7C1405</Color>
    <Color x:Key="Accent900Color">#4D170E</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />

    <SolidColorBrush x:Key="Neutral100Brush" Color="{StaticResource Neutral100Color}" />
    <SolidColorBrush x:Key="Neutral200Brush" Color="{StaticResource Neutral200Color}" />
    <SolidColorBrush x:Key="Neutral300Brush" Color="{StaticResource Neutral300Color}" />
    <SolidColorBrush x:Key="Neutral400Brush" Color="{StaticResource Neutral400Color}" />
    <SolidColorBrush x:Key="Neutral500Brush" Color="{StaticResource Neutral500Color}" />
    <SolidColorBrush x:Key="Neutral600Brush" Color="{StaticResource Neutral600Color}" />
    <SolidColorBrush x:Key="Neutral700Brush" Color="{StaticResource Neutral700Color}" />
    <SolidColorBrush x:Key="Neutral800Brush" Color="{StaticResource Neutral800Color}" />
    <SolidColorBrush x:Key="Neutral900Brush" Color="{StaticResource Neutral900Color}" />

    <SolidColorBrush x:Key="Accent100Brush" Color="{StaticResource Accent100Color}" />
    <SolidColorBrush x:Key="Accent400Brush" Color="{StaticResource Accent400Color}" />
    <SolidColorBrush x:Key="Accent600Brush" Color="{StaticResource Accent600Color}" />
    <SolidColorBrush x:Key="Accent700Brush" Color="{StaticResource Accent700Color}" />
    <SolidColorBrush x:Key="Accent800Brush" Color="{StaticResource Accent800Color}" />

    <!-- 40% ink, so a rule reads the same over paper and over a raised surface. -->
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource TextColor}" Opacity="0.4" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource TextColor}" Opacity="0.07" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource TextColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColor}" Opacity="0.1" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource TextColor}" Opacity="0.04" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Neutral900Color}" Opacity="0.5" />

    <FontFamily x:Key="BodyFont">pack://application:,,,/RouteShield;component/Assets/Fonts/#Archivo</FontFamily>
    <FontFamily x:Key="MediumFont">pack://application:,,,/RouteShield;component/Assets/Fonts/#Archivo SemiBold</FontFamily>
    <FontFamily x:Key="HeadingFont">pack://application:,,,/RouteShield;component/Assets/Fonts/#Archivo ExtraBold</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Every shape is a rectangle with a softened corner; nothing rounds into a pill or a dot. -->
    <CornerRadius x:Key="RadiusXs">5</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>

    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <DropShadowEffect x:Key="ShadowLg" BlurRadius="32" ShadowDepth="12" Direction="270"
                      Color="{StaticResource Neutral900Color}" Opacity="0.22" />

    <!-- ══ Type scale ══ -->

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}" />

    <!-- Small uppercase label above a title or a figure. Pair with Typo.Tracked. -->
    <Style x:Key="Kicker" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Neutral600Brush}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="StatusHeadline" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="46" />
    </Style>

    <Style x:Key="StatFigure" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Neutral700Brush}" />
    </Style>

    <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Neutral700Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource Neutral600Brush}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <!-- A state word rendered inside a row: ROUTED, ARMED, PENDING. -->
    <Style x:Key="StateWord" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Neutral600Brush}" />
    </Style>

</ResourceDictionary>
