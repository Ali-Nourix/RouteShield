<!--
    The light palette: a paper-white ground, near-black ink, one signal red. Every brush the
    interface draws with is declared here and looked up dynamically, so swapping this
    dictionary for Palette.Dark.xaml re-colours the running window in place.

    Brushes come in two kinds. The ramps (Neutral100…900, Accent100…900) are raw steps; the
    semantic brushes below them say what a colour is for, and the dark palette maps those
    roles to different steps rather than inverting the ramp blindly.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ground -->
    <Color x:Key="BgColor">#F3F2F2</Color>
    <Color x:Key="SurfaceColor">#EAE9E9</Color>
    <Color x:Key="TextColor">#201E1D</Color>
    <Color x:Key="AccentColor">#EC3013</Color>
    <Color x:Key="Accent2Color">#E15B47</Color>

    <!-- Neutral ramp -->
    <Color x:Key="Neutral100Color">#F8F4F4</Color>
    <Color x:Key="Neutral200Color">#EAE7E7</Color>
    <Color x:Key="Neutral300Color">#D7D3D3</Color>
    <Color x:Key="Neutral400Color">#BAB6B6</Color>
    <Color x:Key="Neutral500Color">#9B9797</Color>
    <Color x:Key="Neutral600Color">#7D7979</Color>
    <Color x:Key="Neutral700Color">#605D5D</Color>
    <Color x:Key="Neutral800Color">#444141</Color>
    <Color x:Key="Neutral900Color">#2D2B2B</Color>

    <!-- Accent ramp -->
    <Color x:Key="Accent100Color">#FFF2EF</Color>
    <Color x:Key="Accent200Color">#FFE0D9</Color>
    <Color x:Key="Accent300Color">#FFC4B8</Color>
    <Color x:Key="Accent400Color">#FF9783</Color>
    <Color x:Key="Accent500Color">#FF563C</Color>
    <Color x:Key="Accent600Color">#DD2B0F</Color>
    <Color x:Key="Accent700Color">#AE1800</Color>
    <Color x:Key="Accent800Color">#7C1405</Color>
    <Color x:Key="Accent900Color">#4D170E</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />

    <SolidColorBrush x:Key="Neutral100Brush" Color="{StaticResource Neutral100Color}" />
    <SolidColorBrush x:Key="Neutral200Brush" Color="{StaticResource Neutral200Color}" />
    <SolidColorBrush x:Key="Neutral300Brush" Color="{StaticResource Neutral300Color}" />
    <SolidColorBrush x:Key="Neutral400Brush" Color="{StaticResource Neutral400Color}" />
    <SolidColorBrush x:Key="Neutral500Brush" Color="{StaticResource Neutral500Color}" />
    <SolidColorBrush x:Key="Neutral600Brush" Color="{StaticResource Neutral600Color}" />
    <SolidColorBrush x:Key="Neutral700Brush" Color="{StaticResource Neutral700Color}" />
    <SolidColorBrush x:Key="Neutral800Brush" Color="{StaticResource Neutral800Color}" />
    <SolidColorBrush x:Key="Neutral900Brush" Color="{StaticResource Neutral900Color}" />

    <!-- Semantic accent roles -->

    <!-- A faint wash behind a small label: the format chip, the selected combo item. -->
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource Accent100Color}" />
    <!-- Accent-coloured text on the ground or on the tint. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource Accent700Color}" />
    <SolidColorBrush x:Key="AccentTextStrongBrush" Color="{StaticResource Accent800Color}" />
    <!-- Accent text reversed out of the ink card. -->
    <SolidColorBrush x:Key="AccentOnInkBrush" Color="{StaticResource Accent400Color}" />
    <!-- The primary button under the pointer, then pressed. -->
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource Accent600Color}" />
    <SolidColorBrush x:Key="AccentDeeperBrush" Color="{StaticResource Accent700Color}" />

    <!-- Rules and states are ink at low opacity, so they read the same over paper and over a raised surface. -->
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource TextColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource TextColor}" Opacity="0.07" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource TextColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColor}" Opacity="0.1" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource TextColor}" Opacity="0.04" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Neutral900Color}" Opacity="0.5" />

    <!-- Dialogs and popups sit on a soft dark shadow in both palettes. -->
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="32" ShadowDepth="12" Direction="270"
                      Color="#2D2B2B" Opacity="0.22" />

</ResourceDictionary>
