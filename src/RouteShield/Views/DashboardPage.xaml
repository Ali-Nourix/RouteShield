<UserControl x:Class="RouteShield.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RouteShield.Ui"
             xmlns:views="clr-namespace:RouteShield.Views">

    <UserControl.Resources>
        <Style x:Key="MetaCaption" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource Neutral500Brush}" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:PageHeader Kicker="CONTROL CENTRE" Title="Connection">
            <views:PageHeader.Actions>
                <Border Padding="10,5" CornerRadius="{StaticResource RadiusXs}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource TextBrush}"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource Show}}" />
                        <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Neutral400Brush}"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource Hide}}" />
                        <TextBlock Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                    <Setter Property="Text" Value="Standard user" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                            <Setter Property="Text" Value="Administrator" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </views:PageHeader.Actions>
        </views:PageHeader>

        <!-- ══ Connected ══ -->
        <Border Grid.Row="1" Style="{StaticResource InkCard}" Margin="0,20,0,0"
                Visibility="{Binding IsConnected, Converter={StaticResource Show}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" />
                        <TextBlock Style="{StaticResource StatusHeadline}" Margin="12,0,0,0"
                                   Foreground="{DynamicResource BgBrush}" Text="{Binding StateWord}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaCaption}" ui:Typo.Tracked="PROFILE" />
                            <TextBlock Style="{StaticResource MetaValue}" MaxWidth="200"
                                       Text="{Binding SelectedProfileLabel}" />
                        </StackPanel>
                        <Border Width="1" Margin="22,2" Background="{DynamicResource Neutral700Brush}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaCaption}" ui:Typo.Tracked="ROUTING" />
                            <TextBlock Style="{StaticResource MetaValue}" Text="{Binding RouteModeText}" />
                        </StackPanel>
                        <Border Width="1" Margin="22,2" Background="{DynamicResource Neutral700Brush}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetaCaption}" ui:Typo.Tracked="EXIT IP" />
                            <TextBlock Style="{StaticResource MetaValue}" Text="{Binding ExitIpText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Style="{StaticResource InverseButton}" Height="64" Padding="20,0"
                            HorizontalContentAlignment="Stretch" Command="{Binding DisconnectCommand}">
                        <Grid>
                            <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       ui:Typo.Tracked="DISCONNECT" />
                            <TextBlock FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Text="{Binding UptimeText}" />
                        </Grid>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Foreground="{DynamicResource Neutral500Brush}"
                               Text="{Binding CoreVersionText}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Neutral500Brush}"
                               Text="{Binding BridgeSummary}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Neutral500Brush}"
                               Text="{Binding EngineSummary}"
                               Visibility="{Binding EngineSummary, Converter={StaticResource ShowIfPresent}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Neutral500Brush}"
                               Text="{Binding GroupHealthText}"
                               Visibility="{Binding GroupHealthText, Converter={StaticResource ShowIfPresent}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentOnInkBrush}"
                               Text="{Binding OutboundWarning}"
                               Visibility="{Binding OutboundWarning, Converter={StaticResource ShowIfPresent}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentOnInkBrush}"
                               Text="{Binding GroupWarning}"
                               Visibility="{Binding GroupWarning, Converter={StaticResource ShowIfPresent}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentOnInkBrush}"
                               Text="{Binding ProbeFailure}"
                               Visibility="{Binding ProbeFailure, Converter={StaticResource ShowIfPresent}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Not connected ══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0"
                Visibility="{Binding IsConnected, Converter={StaticResource Hide}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="4" VerticalAlignment="Center" BorderThickness="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Neutral500Brush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Style="{StaticResource StatusHeadline}" Margin="12,0,0,0" Text="{Binding StateWord}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HelpText}" Margin="0,14,24,0" MaxWidth="520"
                               HorizontalAlignment="Left" Text="{Binding StatusDetail}" />

                    <Grid Margin="0,18,0,0" MaxWidth="520" HorizontalAlignment="Left"
                          Visibility="{Binding IsTransitioning, Converter={StaticResource Hide}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" ui:Typo.Tracked="ACTIVE PROFILE" />
                            <ComboBox Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboItem}"
                                      Tag="No profile yet"
                                      ItemsSource="{Binding ConnectTargets}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" ui:Typo.Tracked="ROUTING MODE" />
                            <ComboBox Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboItem}"
                                      ItemsSource="{Binding RouteModes}"
                                      SelectedItem="{Binding RouteMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RouteModeName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Height="96" Padding="22,0"
                            HorizontalContentAlignment="Left" Command="{Binding ConnectCommand}"
                            Visibility="{Binding State, Converter={StaticResource ShowForState}, ConverterParameter=Disconnected|Failed}">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="26"
                                       Foreground="{DynamicResource BgBrush}" ui:Typo.Tracked="CONNECT" />
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource BgBrush}"
                                       Text="Start the protected tunnel" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Height="96" Padding="22,0"
                            HorizontalContentAlignment="Left" Command="{Binding StopReconnectCommand}"
                            Visibility="{Binding State, Converter={StaticResource ShowForState}, ConverterParameter=Connecting|Reconnecting|Disconnecting}">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="22" ui:Typo.Tracked="CANCEL" />
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Neutral700Brush}"
                                       Text="Stop and release the adapter" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Height="40" Margin="0,8,0,0"
                            Command="{Binding ValidateCommand}" Content="Validate configuration" />

                    <Button Style="{StaticResource GhostButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Command="{Binding ReleaseKillSwitchCommand}" Content="Release the kill switch"
                            Visibility="{Binding IsKillSwitchHolding, Converter={StaticResource Show}}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding CoreVersionText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Figures ══ -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="0,2,0,0" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Kicker}" ui:Typo.Tracked="UPTIME" />
                    <TextBlock Style="{StaticResource StatFigure}" Text="{Binding UptimeText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="24,0,0,0" BorderBrush="{DynamicResource TextBrush}"
                    BorderThickness="0,2,0,0" Padding="24,12,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Kicker}" ui:Typo.Tracked="HTTP LATENCY" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StatFigure}" Text="{Binding LatencyText}" />
                        <TextBlock Style="{StaticResource StatFigure}" FontSize="17" Margin="6,12,0,0"
                                   VerticalAlignment="Bottom" Text="ms" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="24,0,0,0" BorderBrush="{DynamicResource TextBrush}"
                    BorderThickness="0,2,0,0" Padding="24,12,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Kicker}" ui:Typo.Tracked="THROUGHPUT" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StatFigure}" Text="{Binding ThroughputText}" />
                        <TextBlock Style="{StaticResource StatFigure}" FontSize="17" Margin="6,12,0,0"
                                   VerticalAlignment="Bottom" Text="MB/s" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Lists ══ -->
        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2"
                        Padding="0,0,0,9">
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom"
                                   Text="Applications in scope" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Command="{Binding NavigateCommand}" CommandParameter="Applications" Content="Manage" />
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelpText}" Margin="0,14,0,0"
                           Text="No application is routed yet. Add one from Applications to start splitting traffic."
                           Visibility="{Binding Apps.Count, Converter={StaticResource ShowIfEmpty}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,11">
                                    <Grid>
                                        <TextBlock Style="{StaticResource RowLabel}" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DisplayName}" ToolTip="{Binding Path}" />
                                        <TextBlock Style="{StaticResource StateWord}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   Text="{Binding DataContext.AppStateWord, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Tracked}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <StackPanel Grid.Column="2">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,9">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Protection layers" />
                </Border>

                <views:StateRow Label="Secure DNS through tunnel" IsOn="{Binding DnsProtection}" />
                <views:StateRow Label="IPv6 strict routing" IsOn="{Binding Ipv6Protection}" />
                <views:StateRow Label="Application kill switch" Emphasise="True" OnLabel="ARMED"
                                IsOn="{Binding AppKillSwitch}" />
                <views:StateRow Label="QUIC refused for routed apps" IsOn="{Binding BlockQuic}" />
                <views:StateRow Label="Iranian sites stay local" IsOn="{Binding DirectDomesticSites}" />
                <views:StateRow Label="Local network access" IsOn="{Binding AllowLan}" />
                <views:StateRow Label="Browser bridge for the extension" IsOn="{Binding BrowserBridgeEnabled}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
