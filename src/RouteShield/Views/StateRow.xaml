<UserControl x:Class="RouteShield.Views.StateRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Row" Focusable="False">
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,11">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource RowLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding Label, ElementName=Row}" />

            <Border Grid.Column="1" Padding="9,4" CornerRadius="{StaticResource RadiusXs}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOn, ElementName=Row}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TextBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOn, ElementName=Row}" Value="True" />
                                    <Condition Binding="{Binding Emphasise, ElementName=Row}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                            <Setter Property="Foreground" Value="{DynamicResource Neutral700Brush}" />
                            <Setter Property="Text" Value="{Binding OffLabel, ElementName=Row}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOn, ElementName=Row}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
                                    <Setter Property="Text" Value="{Binding OnLabel, ElementName=Row}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</UserControl>
