<UserControl x:Class="RouteShield.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RouteShield.Ui"
             x:Name="Header" Focusable="False">
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource Kicker}"
                           Text="{Binding Kicker, ElementName=Header, Converter={StaticResource Tracked}}" />
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title, ElementName=Header}" />
            </StackPanel>

            <ContentPresenter Grid.Column="1" VerticalAlignment="Bottom"
                              Content="{Binding Actions, ElementName=Header}" />
        </Grid>
    </Border>
</UserControl>
