<UserControl x:Class="RouteShield.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RouteShield.Ui"
             x:Name="Header" Focusable="False">
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,14">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Margin="0,4,16,0" VerticalAlignment="Center">
                    <ui:Icon Kind="{Binding IconKind, ElementName=Header}" Width="24" Height="24" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource Kicker}" Text="{Binding Kicker, ElementName=Header, Converter={StaticResource Tracked}}" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title, ElementName=Header}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <ContentPresenter Margin="0,16,0,0" HorizontalAlignment="Left" Content="{Binding Actions, ElementName=Header}" />
        </StackPanel>
    </Border>
</UserControl>
