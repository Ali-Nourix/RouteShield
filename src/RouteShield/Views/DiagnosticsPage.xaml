<UserControl x:Class="RouteShield.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RouteShield.Ui"
             xmlns:views="clr-namespace:RouteShield.Views">

    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:PageHeader Kicker="SUPPORT" Title="Diagnostics">
            <views:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogFolderCommand}"
                            Content="Open log folder" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Command="{Binding ExportDiagnosticsCommand}" Content="Export bundle" />
                </StackPanel>
            </views:PageHeader.Actions>
        </views:PageHeader>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding LogCategories}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource AppRadio}" Margin="0,0,18,0" GroupName="LogCategory"
                                     Content="{Binding}" CommandParameter="{Binding}"
                                     Command="{Binding DataContext.SetLogCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource ValueMatch}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="DataContext.LogCategoryFilter" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </RadioButton.IsChecked>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Margin="18,0" Tag="Filter events"
                     Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Text="{Binding LogBufferText}" />
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16,12" CornerRadius="{StaticResource RadiusMd}"
                Background="{StaticResource TextBrush}">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{StaticResource Neutral500Brush}"
                                           Text="{Binding Timestamp, StringFormat=HH\\:mm\\:ss.fff}" />
                                <TextBlock Margin="14,0,0,0" Width="96" FontFamily="{StaticResource HeadingFont}"
                                           FontSize="10" VerticalAlignment="Center"
                                           Foreground="{StaticResource Accent400Brush}"
                                           Text="{Binding Category, Converter={StaticResource Tracked}}" />
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource Neutral200Brush}" Text="{Binding Message}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                       HorizontalAlignment="Left"
                       Text="Exported bundles never contain profile secrets or subscription URLs." />
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding ClearLogCommand}" Content="Clear visible log" />
        </Grid>
    </Grid>
</UserControl>
