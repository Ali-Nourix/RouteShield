<Window x:Class="RouteShield.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RouteShield.Ui"
        xmlns:views="clr-namespace:RouteShield.Views"
        Title="Welcome to RouteShield"
        Width="980" Height="620" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="StepOrdinal" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Neutral500Brush}" />
            <Setter Property="Margin" Value="0,2,18,0" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontFamily" Value="{StaticResource MediumFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="{StaticResource RadiusLg}" Margin="18"
            Effect="{StaticResource ShadowLg}" ClipToBounds="True">
        <Grid MouseLeftButtonDown="OnDragWindow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource TextBrush}" Padding="40,44">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="2" Background="{StaticResource Neutral800Brush}" Margin="0,0,0,16" />
                        <TextBlock Style="{StaticResource Kicker}" Foreground="{StaticResource Neutral500Brush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding VersionLine, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Tracked}}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <views:BrandMark Width="44" Height="52" HorizontalAlignment="Left"
                                         ShieldBrush="{StaticResource BgBrush}"
                                         RouteBrush="{StaticResource AccentBrush}" />
                        <TextBlock Margin="0,28,0,0" FontFamily="{StaticResource HeadingFont}" FontSize="40"
                                   LineHeight="44" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource BgBrush}"
                                   Text="Route&#x0a;only what&#x0a;you choose." />
                        <TextBlock Margin="0,20,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource Neutral400Brush}"
                                   Text="RouteShield sends the applications you pick through the sing-box core and leaves the rest of Windows on your own connection." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Padding="40,44">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Click="OnFinish" Content="Skip and explore" />
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Click="OnFinish" Content="Continue" />
                    </Grid>

                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" ui:Typo.Tracked="SET UP · 3 STEPS" />
                        <TextBlock Margin="0,12,0,0" FontFamily="{StaticResource HeadingFont}" FontSize="27"
                                   LineHeight="31" LineStackingStrategy="BlockLineHeight" Text="Three things before&#x0a;your first tunnel" />

                        <Border Margin="0,28,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                Padding="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource StepOrdinal}" Text="01" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource StepTitle}" Text="Grant administrator access" />
                                    <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0"
                                               Text="Required to create the TUN adapter and the firewall rules." />
                                </StackPanel>
                                <TextBlock x:Name="ElevationState" Grid.Column="2" Style="{StaticResource StateWord}"
                                           VerticalAlignment="Top" Margin="12,2,0,0" />
                            </Grid>
                        </Border>

                        <Border Margin="0,18,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                Padding="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource StepOrdinal}" Text="02" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource StepTitle}" Text="Add a profile or subscription" />
                                    <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0"
                                               Text="Paste a VLESS, VMess, Trojan or Shadowsocks link, a WireGuard file, a sing-box configuration, or an HTTPS subscription URL." />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Click="OnOpenProfiles"
                                                Content="Paste a link" />
                                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                                Command="{Binding ImportProfileCommand}" Content="Import file" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource StepOrdinal}" Text="03" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource StepTitle}" Text="Pick the applications to route" />
                                    <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0"
                                               Text="Choose from the running processes, or browse for an executable." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
