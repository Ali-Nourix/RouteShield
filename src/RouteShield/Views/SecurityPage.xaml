<UserControl x:Class="RouteShield.Views.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RouteShield.Ui"
             xmlns:views="clr-namespace:RouteShield.Views">

    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}">
            <Setter Property="Margin" Value="0,14" />
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontFamily" Value="{StaticResource MediumFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:PageHeader Kicker="PREFERENCES" Title="Security &amp; behaviour">
            <views:PageHeader.Actions>
                <TextBlock Style="{StaticResource Caption}" Text="Saved automatically" />
            </views:PageHeader.Actions>
        </views:PageHeader>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,9">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Network protection" />
                </Border>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <CheckBox Style="{StaticResource SettingRow}" IsChecked="{Binding AppKillSwitch, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingName}" Text="Application kill switch" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left"
                                       Text="Blocks the selected executables from reaching physical adapters whenever the tunnel drops." />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <CheckBox Style="{StaticResource SettingRow}" IsChecked="{Binding DnsProtection, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingName}" Text="Secure DNS (answer names inside RouteShield)" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left"
                                       Text="Names are answered instantly from a private range and the name itself travels to the proxy, so a blocked or poisoned resolver cannot break a routed application. Direct traffic still resolves on your own connection." />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <CheckBox Style="{StaticResource SettingRow}" IsChecked="{Binding Ipv6Protection, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingName}" Text="Include IPv6 in strict routing" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left"
                                       Text="Recommended — prevents IPv6 traffic from bypassing the policy." />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <CheckBox Style="{StaticResource SettingRow}" IsChecked="{Binding TlsFragment, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingName}" Text="Fragment TLS handshakes to the server" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left"
                                       Text="Splits each handshake with the proxy server across several packets and TLS records, so a firewall that reads the server name from the first packet never sees it whole. Turn on when connections stall or reset right after connecting; it costs a little on every new connection. Takes effect on the next connect." />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <CheckBox Style="{StaticResource SettingRow}" IsChecked="{Binding AllowLan, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingName}" Text="Allow access to private / local networks" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left"
                                       Text="Keeps printers and NAS devices reachable while connected." />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,9">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Reliability" />
                        </Border>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,13"
                                      IsChecked="{Binding AutoReconnect, Mode=TwoWay}"
                                      Content="Reconnect automatically with backoff" />
                        </Border>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,13"
                                      IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                                      Content="Connect the last profile on launch" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,9">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Windows integration" />
                        </Border>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,13"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      Content="Start with Windows" />
                        </Border>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <CheckBox Style="{StaticResource AppCheckBox}" Margin="0,13"
                                      IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                      Content="Minimise to the notification area" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Margin="0,26,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,9">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                </Border>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingName}" Text="Theme" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0" MaxWidth="620"
                                       HorizontalAlignment="Left"
                                       Text="Paper or darkness. System follows the Windows app colour and changes with it." />
                        </StackPanel>

                        <Border Grid.Column="1" Margin="24,0,0,0" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
                                BorderBrush="{DynamicResource DividerBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentOption}" Content="System" GroupName="Theme"
                                             IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
                                <RadioButton Style="{StaticResource SegmentOption}" Content="Light" GroupName="Theme"
                                             IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource SegmentOption}" Content="Dark" GroupName="Theme"
                                             IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Margin="0,26,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,9">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Browser extension" />
                </Border>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <CheckBox Style="{StaticResource SettingRow}" IsChecked="{Binding BrowserBridgeEnabled, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingName}" Text="Browser bridge" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left"
                                       Text="Lets the RouteShield add-on choose a profile per tab (Firefox) or per site (Chrome), or take a tab out of the VPN entirely. Everything stays on 127.0.0.1; nothing is opened to the network." />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding BridgeSummary}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding PinnedSummary}" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <Grid Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource HelpText}" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left"
                               Text="Firefox: open the .xpi from the extensions folder (Developer Edition and Nightly can keep it after setting xpinstall.signatures.required to false), or about:debugging → Load Temporary Add-on for one session. Chrome: chrome://extensions → Developer mode → Load unpacked → the chrome folder." />
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenExtensionFolderCommand}" Content="Open extension folder" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                       HorizontalAlignment="Left"
                       Text="Settings live in %LocalAppData%\RouteShield\settings.json — secrets sealed with DPAPI." />
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding ResetSettingsCommand}" Content="Reset to defaults" />
        </Grid>
    </Grid>
</UserControl>
