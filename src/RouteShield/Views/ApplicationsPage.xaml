<UserControl x:Class="RouteShield.Views.ApplicationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RouteShield.Ui"
             xmlns:views="clr-namespace:RouteShield.Views"
             x:Name="Page">

    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:PageHeader Kicker="SPLIT TUNNEL" Title="Application routing">
            <views:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddRunningProcessCommand}"
                            Content="Running processes" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Command="{Binding BrowseExecutableCommand}" Content="Choose EXE" />
                </StackPanel>
            </views:PageHeader.Actions>
        </views:PageHeader>

        <Border Grid.Row="1" Margin="0,22,0,0" Padding="18,14" CornerRadius="{StaticResource RadiusMd}"
                Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Kicker}" VerticalAlignment="Center" Margin="0,0,20,0"
                           ui:Typo.Tracked="MODE" />
                <RadioButton Style="{StaticResource AppRadio}" Margin="0,0,22,0" Content="Selected applications"
                             IsChecked="{Binding RouteMode, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=SelectedAppsOnly}" />
                <RadioButton Style="{StaticResource AppRadio}" Margin="0,0,22,0" Content="All except selected"
                             IsChecked="{Binding RouteMode, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=AllExceptSelected}" />
                <RadioButton Style="{StaticResource AppRadio}" Content="Full system tunnel"
                             IsChecked="{Binding RouteMode, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter=FullTunnel}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"
                    Background="{StaticResource AccentBrush}" />
            <TextBlock Style="{StaticResource HelpText}" VerticalAlignment="Center"
                       Text="The application kill switch is enforced only while Selected applications mode is active." />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,22,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,2"
                Padding="0,0,0,9">
            <Grid>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Protected executables" />
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Text="{Binding AppSummary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource Kicker}" ui:Typo.Tracked="APPLICATION" />
                <TextBlock Grid.Column="2" Style="{StaticResource Kicker}" ui:Typo.Tracked="EXECUTABLE PATH" />
                <TextBlock Grid.Column="3" Style="{StaticResource Kicker}" ui:Typo.Tracked="STATUS" />
            </Grid>

            <TextBlock Grid.Row="1" Style="{StaticResource HelpText}" VerticalAlignment="Top"
                       Text="Nothing is routed yet. Pick a running process, or browse for an executable."
                       Visibility="{Binding Apps.Count, Converter={StaticResource ShowIfEmpty}}" />

            <ListBox Grid.Row="1" x:Name="AppList" Style="{StaticResource AppListBox}" ItemsSource="{Binding Apps}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <Border Width="9" Height="9" CornerRadius="2" Margin="10,0,0,0" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" ToolTip="{Binding StateLabel}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Neutral400Brush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Path}" ToolTip="{Binding Path}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource StateWord}" VerticalAlignment="Center"
                                       Text="{Binding DataContext.AppStateWord, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Tracked}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Text="Firewall rules are removed automatically when the tunnel stops." />
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding RemoveAppCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=AppList}"
                    Content="Remove selected" />
        </Grid>
    </Grid>
</UserControl>
