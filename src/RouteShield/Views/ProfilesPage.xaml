<UserControl x:Class="RouteShield.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RouteShield.Ui"
             xmlns:views="clr-namespace:RouteShield.Views">

    <UserControl.Resources>
        <!-- One line of the library: name, format, and how the node last measured. -->
        <DataTemplate x:Key="ProfileRow">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★" Margin="0,0,6,0" Visibility="{Binding Profile.IsFavorite, Converter={StaticResource Show}}" />
                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Profile.Name}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                            <Setter Property="FontFamily" Value="{StaticResource MediumFont}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                Visibility="{Binding IsAutomatic, Converter={StaticResource Show}}"
                                ToolTip="The core picks the fastest node of this subscription and fails over on its own">
                            <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="8"
                                       Foreground="{DynamicResource BgBrush}" ui:Typo.Tracked="AUTO" />
                        </Border>
                        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource TextBrush}"
                                Visibility="{Binding Profile.BrowserPinned, Converter={StaticResource Show}}"
                                ToolTip="Offered to the browser extension">
                            <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="8"
                                       Foreground="{DynamicResource BgBrush}" ui:Typo.Tracked="WEB" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Text="{Binding Detail}" />
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="12,0,0,0"
                        Visibility="{Binding HasLatency, Converter={StaticResource Show}}">
                    <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="10"
                               Text="{Binding LatencyText, Converter={StaticResource Tracked}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                <Setter Property="Foreground" Value="{DynamicResource Neutral600Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LatencyState}" Value="Measured">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LatencyState}" Value="Testing">
                                        <Setter Property="Foreground" Value="{DynamicResource Neutral500Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- The heading over each section: manual profiles, or a subscription with its status and actions. -->
        <Style x:Key="SectionHeader" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <Border Margin="0,18,0,0" Padding="0,0,0,8" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Name.Title}" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0"
                                                       VerticalAlignment="Bottom">
                                                <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" entries" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name.Subscription.AttentionText}" Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding Name.Subscription.NeedsAttention, Converter={StaticResource Show}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name.Subscription.StatusText}"
                                                   ToolTip="{Binding Name.Subscription.StatusDetails}"
                                                   Visibility="{Binding Name.IsSubscription, Converter={StaticResource Show}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name.Subscription.HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                Visibility="{Binding Name.IsSubscription, Converter={StaticResource Show}}">
                                        <Button Tag="Refresh" Style="{StaticResource GhostButton}" Content="Refresh"
                                                Command="{Binding DataContext.RefreshSubscriptionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding Name.Subscription}" />
                                        <Button Tag="Tools" Style="{StaticResource GhostButton}" Content="Edit"
                                                Command="{Binding DataContext.EditSubscriptionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding Name.Subscription}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The editor column and the gap before it collapse to nothing while the editor is closed. -->
        <Style x:Key="EditorColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                    <Setter Property="Width" Value="1.15*" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorGap" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                    <Setter Property="Width" Value="28" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The header button that opens and closes the editor reads as pressed while it is open. -->
        <Style x:Key="EditorToggle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Content" Value="Open editor" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                    <Setter Property="Content" Value="Close editor" />
                    <Setter Property="Background" Value="{DynamicResource TextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageGutter}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:PageHeader IconKind="Library" Kicker="LIBRARY" Title="Profiles &amp; subscriptions">
            <views:PageHeader.Actions>
                <WrapPanel>
                    <Button Style="{StaticResource EditorToggle}" Command="{Binding ToggleEditorCommand}" />
                    <Button Tag="Link" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding AddSubscriptionCommand}" Content="Add subscription" />
                    <Button Tag="Download" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding ImportProfileCommand}" Content="Import file" />
                    <Button Tag="Plus" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Command="{Binding NewProfileCommand}" Content="New profile" />
                </WrapPanel>
            </views:PageHeader.Actions>
        </views:PageHeader>

        <Border Grid.Row="2" Margin="0,12,0,8" Padding="16" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
        <StackPanel>
            <WrapPanel>
                <TextBox Width="220" Margin="0,0,8,8" Style="{StaticResource AppTextBox}" Tag="Search name or protocol"
                         Text="{Binding LibraryQuery, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="135" Margin="0,0,8,8" Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboItem}"
                          ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding ProtocolFilter}" ToolTip="Filter protocol" />
                <ComboBox Width="105" Margin="0,0,8,8" Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboItem}"
                          ItemsSource="{Binding CountryOptions}" SelectedItem="{Binding CountryFilter}" ToolTip="Claimed country from the name's flag only; not measured geolocation" />
                <CheckBox Content="Favorites" Style="{StaticResource AppCheckBox}" IsChecked="{Binding FavoritesOnly}" Margin="0,0,12,8" />
                <CheckBox Content="Working only" Style="{StaticResource AppCheckBox}" IsChecked="{Binding WorkingOnly}" Margin="0,0,12,8" />
                <Button Tag="Close" Content="Clear filters" Style="{StaticResource GhostButton}" Command="{Binding ResetLibraryFiltersCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <WrapPanel>
                <Button Tag="Connect" Content="Quick connect" Style="{StaticResource PrimaryButton}" Command="{Binding QuickConnectCommand}" Margin="0,0,8,6"
                        ToolTip="Test matching saved profiles and connect only to the fastest successful HTTPS result (Ctrl+Shift+K)" />
                <Button Tag="Clipboard" Content="Paste configs" Style="{StaticResource SecondaryButton}" Command="{Binding ImportClipboardCommand}" Margin="0,0,8,6" ToolTip="Import share links or Base64 text (Ctrl+Shift+V)" />
            </WrapPanel>
            <Expander Margin="0,6,0,8" Foreground="{DynamicResource TextBrush}">
                <Expander.Header>
                    <Border MinHeight="44" Background="Transparent" Padding="4,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Kind="Tools" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Selected node &amp; library tools" Style="{StaticResource RowLabel}" />
                    </StackPanel>
                    </Border>
                </Expander.Header>
                <WrapPanel Margin="0,12,0,0">
                <Button Tag="Activity" Content="Test selected" Style="{StaticResource SecondaryButton}" Command="{Binding TestSelectedCommand}" Margin="0,0,8,6" />
                <Button Tag="Copy" Content="Copy selected" Style="{StaticResource SecondaryButton}" Command="{Binding CopyProfileCommand}" Margin="0,0,8,6" />
                <Button Tag="Upload" Content="Export selected" Style="{StaticResource SecondaryButton}" Command="{Binding ExportProfileCommand}" Margin="0,0,8,6" />
                <Button Tag="Filter" Content="Deduplicate" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveDuplicatesCommand}" Margin="0,0,8,6" />
                <CheckBox Content="Favorite selected" Style="{StaticResource AppCheckBox}" IsEnabled="{Binding CanEditSelectedProfile}"
                          IsChecked="{Binding SelectedProfileFavorite}" Margin="0,0,8,6" />
                </WrapPanel>
            </Expander>
            <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Caption}" />
            <TextBlock Text="No entries match. Clear filters to see all nodes; Quick connect never substitutes a nonmatching node."
                       TextWrapping="Wrap" Visibility="{Binding NoFilterMatches, Converter={StaticResource Show}}" Style="{StaticResource HelpText}" Margin="0,6,0,0" />
        </StackPanel>
        </Border>

        <!-- ══ Toolbar ══ -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{StaticResource EditorGap}" />
                <ColumnDefinition Style="{StaticResource EditorColumn}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <WrapPanel>
                    <Button Tag="Globe" Style="{StaticResource SecondaryButton}" Content="Free &amp; connect" Margin="0,0,8,0"
                            Command="{Binding FreeConnectCommand}"
                            ToolTip="Opt-in public GitHub configurations: test HTTPS latency and connect to the fastest working candidate" />
                    <Button Tag="Activity" Style="{StaticResource SecondaryButton}" Content="Test latency"
                            Command="{Binding TestLatencyCommand}"
                            Visibility="{Binding IsTestingLatency, Converter={StaticResource Hide}}" />
                    <Button Tag="Close" Style="{StaticResource SecondaryButton}" Content="Stop testing"
                            Command="{Binding CancelLatencyCommand}"
                            Visibility="{Binding IsTestingLatency, Converter={StaticResource Show}}" />

                    <Border Margin="10,0,0,0" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1"
                            BorderBrush="{DynamicResource DividerBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentOption}" Content="Name" GroupName="LibrarySort"
                                         IsChecked="{Binding SortByLatency, Converter={StaticResource Not}, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource SegmentOption}" Content="Latency" GroupName="LibrarySort"
                                         IsChecked="{Binding SortByLatency, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,8,0,0"
                           Text="{Binding LibrarySummary}" />
            </StackPanel>

            <Border Grid.Column="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,2"
                    Padding="0,0,0,9" VerticalAlignment="Bottom"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource Show}}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Profile editor" />
                        <Border Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center"
                                CornerRadius="{StaticResource RadiusXs}" Background="{DynamicResource AccentTintBrush}">
                            <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="10"
                                       Foreground="{DynamicResource AccentTextStrongBrush}"
                                       Text="{Binding EditorFormat, Converter={StaticResource Tracked}}" />
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Command="{Binding DetectFormatCommand}" Content="Check format"
                            Visibility="{Binding CanEditSelectedProfile, Converter={StaticResource Show}}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{StaticResource EditorGap}" />
                <ColumnDefinition Style="{StaticResource EditorColumn}" />
            </Grid.ColumnDefinitions>

            <!-- ══ Library ══ -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding EmptySubscriptions}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Tag="Refresh" Style="{StaticResource GhostButton}" Content="Refresh"
                                                Command="{Binding DataContext.RefreshSubscriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Tag="Tools" Style="{StaticResource GhostButton}" Content="Edit"
                                                Command="{Binding DataContext.EditSubscriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}"
                                                   ToolTip="{Binding StatusDetails}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Style="{StaticResource HelpText}" Margin="0,22,0,0" VerticalAlignment="Top"
                           Text="Nothing here yet. Add a subscription, import a file, or open the editor and paste a share link."
                           Visibility="{Binding Profiles.Count, Converter={StaticResource ShowIfEmpty}}" />

                <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" Margin="0,0,0,0"
                         ItemsSource="{Binding LibraryView}"
                         ItemTemplate="{StaticResource ProfileRow}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource SectionHeader}" />
                    </ListBox.GroupStyle>
                </ListBox>
            </Grid>

            <!-- ══ Editor ══ -->
            <DockPanel Grid.Column="2" Margin="0,16,0,0"
                       Visibility="{Binding IsEditorOpen, Converter={StaticResource Show}}">
                <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding CanEditSelectedProfile}">
                    <TextBlock Style="{StaticResource FieldLabel}" ui:Typo.Tracked="PROFILE NAME" />
                    <TextBox Style="{StaticResource AppTextBox}" Tag="Frankfurt"
                             Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Border Padding="14,12" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SurfaceBrush}"
                            IsEnabled="{Binding CanEditSelectedProfile}">
                        <CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{Binding SelectedProfilePinned, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource MediumFont}" FontSize="13.5"
                                           Text="Offer this profile to the browser extension" />
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0"
                                           Text="Pinned profiles show up as per-tab choices in Firefox and per-site choices in Chrome. Takes effect on the next connect." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360" HorizontalAlignment="Left"
                                   Text="Saved secrets are encrypted with Windows DPAPI and never leave this machine." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Tag="Trash" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteProfileCommand}"
                                    Content="Delete" />
                            <Button Tag="Check" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding SaveProfileCommand}" Content="Save profile" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBox Style="{StaticResource CodeTextBox}" Margin="0,14,0,0"
                         Tag="vless://… · hysteria2://… · a WireGuard .conf · a sing-box configuration"
                         IsReadOnly="{Binding CanEditSelectedProfile, Converter={StaticResource Not}}"
                         Text="{Binding EditorConfig, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
