<Window x:Class="RouteShield.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RouteShield.Ui"
        Title="RouteShield"
        SizeToContent="Height" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">

    <Border Background="{StaticResource BgBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="28,26"
            Effect="{StaticResource ShadowLg}" Margin="24" MouseLeftButtonDown="OnDragWindow">
        <StackPanel>
            <TextBlock x:Name="KickerText" Style="{StaticResource Kicker}"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="TitleText" Style="{StaticResource BaseText}" Margin="0,12,0,0"
                       FontFamily="{StaticResource HeadingFont}" FontSize="26" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" Style="{StaticResource HelpText}" Margin="0,14,0,0" FontSize="13"
                       MaxHeight="220" TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Close"
                        Click="OnCancel" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Content="Continue" Click="OnConfirm" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
