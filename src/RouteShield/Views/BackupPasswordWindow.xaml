<Window x:Class="RouteShield.Views.BackupPasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:RouteShield.Ui"
 Title="Encrypted library backup" Width="528" SizeToContent="Height" ResizeMode="NoResize"
 WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource TextBrush}">
 <Border Margin="24" Padding="28" CornerRadius="14" Background="{DynamicResource BgBrush}" Effect="{DynamicResource ShadowLg}">
 <StackPanel>
  <ui:Icon Kind="Lock" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,14" Foreground="{DynamicResource AccentTextBrush}" />
  <TextBlock MouseLeftButtonDown="OnDragTitle" Text="Library backup password" Style="{StaticResource SectionTitle}" />
  <TextBlock Text="Use at least 12 characters. There is no password recovery. The backup excludes the free pool and Windows/security settings." TextWrapping="Wrap" Margin="0,12,0,14" />
  <PasswordBox Style="{StaticResource AppPasswordBox}" x:Name="PasswordInput" Padding="8" MinHeight="44" AutomationProperties.Name="Backup password" />
  <TextBlock x:Name="ConfirmLabel" Text="Repeat password for a new backup" Margin="0,12,0,6" />
  <PasswordBox Style="{StaticResource AppPasswordBox}" x:Name="ConfirmInput" Padding="8" MinHeight="44" AutomationProperties.Name="Repeat backup password" />
  <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" />
   <Button Content="Continue" IsDefault="True" Click="OnContinue" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
  </StackPanel>
 </StackPanel>
 </Border>
</Window>
