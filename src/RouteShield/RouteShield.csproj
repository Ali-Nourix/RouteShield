<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RouteShield.ico</ApplicationIcon>
    <AssemblyName>RouteShield</AssemblyName>
    <RootNamespace>RouteShield</RootNamespace>
    <Version>1.6.0</Version>
    <Company>RouteShield</Company>
    <Product>RouteShield</Product>
    <Description>Split-tunnel VPN controller for Windows, powered by the sing-box core.</Description>
    <Copyright>Copyright (c) 2026 Nourix</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <!-- WPF owns process DPI awareness; WinForms is referenced only for the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RouteShield.Core\RouteShield.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is here only for the tray icon; its implicit usings would otherwise
         collide with WPF on Application, Brush, Size and friends in every file. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RouteShield.png" />
    <Resource Include="Assets\RouteShield.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
